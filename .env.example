# ==============================================================================
# DIGITAL PAVTI BOOK - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Secure JWT Session Secret (Generate a strong random string)
AUTH_SECRET=mandal-digital-pavti-book-secure-jwt-secret-key-2026-super-safe

# Storage Provider Option: 'local' (Free Local File DB) OR 'google' (Google Sheets & Drive)
STORAGE_PROVIDER=local

# ------------------------------------------------------------------------------
# OPTIONAL: Google Sheets & Google Drive Integration (Zero-Cost Production Setup)
# ------------------------------------------------------------------------------
# Leave blank to use the built-in LocalStorageProvider out of the box.
# For setup instructions, see GOOGLE_SHEETS_SETUP.md

GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""

# ==============================================================================
# DIGITAL PAVTI BOOK - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Secure JWT Session Secret (Generate a strong random string)
AUTH_SECRET=mandal-digital-pavti-book-secure-jwt-secret-key-2026-super-safe

# Storage Provider Option: 'supabase' (Cloud Database) | 'local' (Local File DB) | 'google' (Google Sheets)
STORAGE_PROVIDER=supabase

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & BACKEND (RECOMMENDED FOR MULTI-DEVICE & PRODUCTION)
# ------------------------------------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Run the SQL in supabase/schema.sql via the Supabase SQL Editor
# 3. Copy your project API keys from Project Settings -> API
# For full setup guide, see SUPABASE_SETUP.md

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# OPTIONAL: Google Sheets & Google Drive Integration (Zero-Cost Alternative)
# ------------------------------------------------------------------------------
# For setup instructions, see GOOGLE_SHEETS_SETUP.md

GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
